<Layouts.app flash={@flash} variant={:plain}>
  <main
    id="froth-home"
    class="relative isolate min-h-screen overflow-x-hidden bg-slate-950 text-slate-100"
  >
    <div class="absolute inset-0 bg-slate-950"></div>
    <div class="absolute -left-24 top-12 size-72 rounded-full bg-cyan-500/20 blur-3xl">
    </div>
    <div class="absolute right-0 top-1/3 size-80 rounded-full bg-emerald-400/10 blur-3xl">
    </div>
    <div class="absolute bottom-0 left-1/2 size-96 -translate-x-1/2 rounded-full bg-indigo-500/10 blur-3xl">
    </div>

    <div class="relative mx-auto max-w-7xl px-6 py-12 sm:px-8 lg:px-10 lg:py-16">
      <section id="froth-hero" class="max-w-3xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[10px] uppercase tracking-[0.24em] text-cyan-100/80">
          <.icon name="hero-sparkles" class="size-3.5" /> Froth control room
        </p>

        <h1 class="mt-5 text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl">
          Charlie and Froth, at a glance.
        </h1>

        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg">
          A compact view of memory, background work, analyses, and the operator surfaces
          that are still useful.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            id="froth-hero-codex"
            href={~p"/froth/mini/codex"}
            class="inline-flex items-center gap-2 rounded-full border border-cyan-400/20 bg-cyan-400/10 px-4 py-2 text-sm font-medium text-cyan-50 transition hover:-translate-y-0.5 hover:border-cyan-300/40 hover:bg-cyan-400/15"
          >
            <.icon name="hero-code-bracket-square" class="size-4" />
            Codex index
          </a>

          <a
            id="froth-hero-follow"
            href={~p"/froth/follow"}
            class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2 text-sm font-medium text-emerald-50 transition hover:-translate-y-0.5 hover:border-emerald-300/40 hover:bg-emerald-400/15"
          >
            <.icon name="hero-rss" class="size-4" /> Follow
          </a>

          <a
            id="froth-hero-chronicle"
            href={~p"/froth/summaries"}
            class="inline-flex items-center gap-2 rounded-full border border-rose-400/20 bg-rose-400/10 px-4 py-2 text-sm font-medium text-rose-50 transition hover:-translate-y-0.5 hover:border-rose-300/40 hover:bg-rose-400/15"
          >
            <.icon name="hero-book-open" class="size-4" /> Chronicle
          </a>
        </div>
      </section>

      <section id="froth-dashboard" class="mt-12">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <a
            href={~p"/froth/jobs"}
            class="group rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-emerald-300/30 hover:bg-white/10"
          >
            <p class="text-xs uppercase tracking-[0.18em] text-slate-400">
              Background work
            </p>
            <p class="mt-3 text-3xl font-semibold text-white">
              {@dashboard.active_tasks}
            </p>
            <p class="mt-1 text-sm text-slate-400">
              active tasks · {@dashboard.executing_jobs} jobs executing
            </p>
          </a>
          <a
            href={~p"/froth/jobs"}
            class="group rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-amber-300/30 hover:bg-white/10"
          >
            <p class="text-xs uppercase tracking-[0.18em] text-slate-400">
              Queue
            </p>
            <p class="mt-3 text-3xl font-semibold text-white">
              {@dashboard.queued_jobs}
            </p>
            <p class="mt-1 text-sm text-slate-400">
              scheduled or available · {@dashboard.discarded_jobs} discarded
            </p>
          </a>
          <a
            href={~p"/froth/analyses/day"}
            class="group rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-sky-300/30 hover:bg-white/10"
          >
            <p class="text-xs uppercase tracking-[0.18em] text-slate-400">
              Analyses
            </p>
            <p class="mt-3 text-3xl font-semibold text-white">
              {@dashboard.analysis_count}
            </p>
            <p class="mt-1 text-sm text-slate-400">
              persisted media readings
            </p>
          </a>
          <a
            href={~p"/froth/summaries"}
            class="group rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-rose-300/30 hover:bg-white/10"
          >
            <p class="text-xs uppercase tracking-[0.18em] text-slate-400">
              Long memory
            </p>
            <p class="mt-3 text-3xl font-semibold text-white">
              {@dashboard.weekly_count}
            </p>
            <p class="mt-1 text-sm text-slate-400">
              generated weekly chapters
            </p>
          </a>
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <div
            id="froth-recent-tasks"
            class="rounded-3xl border border-white/10 bg-white/5 p-5"
          >
            <div class="flex items-center justify-between">
              <h2 class="text-sm font-semibold text-white">Recent tasks</h2>
              <a
                href={~p"/froth/jobs"}
                class="text-xs text-slate-400 transition hover:text-white"
              >
                Open jobs
              </a>
            </div>
            <div class="mt-4 divide-y divide-white/5">
              <div
                :for={task <- @dashboard.recent_tasks}
                class="flex items-center gap-3 py-3"
              >
                <span class={[
                  "size-2 shrink-0 rounded-full",
                  task.status in ["running", "pending"] && "bg-emerald-400",
                  task.status == "completed" && "bg-cyan-400",
                  task.status in ["failed", "stopped"] && "bg-slate-600"
                ]}>
                </span>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm text-slate-200">
                    {task.label || task.id}
                  </p>
                  <p class="text-xs text-slate-500">
                    {task.type} · {task.status}
                  </p>
                </div>
              </div>
              <p
                :if={@dashboard.recent_tasks == []}
                class="py-6 text-sm text-slate-500"
              >
                No tasks recorded.
              </p>
            </div>
          </div>

          <div
            id="froth-recent-analyses"
            class="rounded-3xl border border-white/10 bg-white/5 p-5"
          >
            <div class="flex items-center justify-between">
              <h2 class="text-sm font-semibold text-white">
                Latest analyses
              </h2>
              <a
                href={~p"/froth/analyses/day"}
                class="text-xs text-slate-400 transition hover:text-white"
              >
                Browse by day
              </a>
            </div>
            <div class="mt-4 divide-y divide-white/5">
              <div
                :for={analysis <- @dashboard.recent_analyses}
                class="flex items-center gap-3 py-3"
              >
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-xl bg-sky-400/10 text-sky-200">
                  <.icon name="hero-document-magnifying-glass" class="size-4" />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm text-slate-200">
                    {analysis.metadata["filename"] ||
                      "#{analysis.type} analysis"}
                  </p>
                  <p class="text-xs text-slate-500">
                    {analysis.type} · {Calendar.strftime(
                      analysis.generated_at,
                      "%b %-d, %H:%M UTC"
                    )}
                  </p>
                </div>
              </div>
              <p
                :if={@dashboard.recent_analyses == []}
                class="py-6 text-sm text-slate-500"
              >
                No analyses recorded.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-14">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 class="text-sm uppercase tracking-[0.24em] text-cyan-200/70">
              Core surfaces
            </h2>
            <p class="mt-2 text-sm text-slate-400">
              The first stop for live inspection and day-to-day browsing.
            </p>
          </div>
        </div>

        <div
          id="froth-primary-links"
          class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3"
        >
          <a
            :for={link <- @primary_links}
            id={link.id}
            href={link.href}
            class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-5 shadow-lg shadow-slate-950/20 transition duration-200 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10 hover:shadow-cyan-950/20"
          >
            <div class="absolute inset-0 bg-gradient-to-br from-white/5 via-transparent to-transparent opacity-0 transition duration-200 group-hover:opacity-100">
            </div>

            <div class="relative flex items-start justify-between gap-4">
              <span class={[
                "inline-flex size-11 shrink-0 items-center justify-center rounded-2xl border",
                link.icon_class
              ]}>
                <.icon name={link.icon} class="size-5" />
              </span>

              <span class={[
                "rounded-full border px-2 py-1 text-[10px] uppercase tracking-[0.18em]",
                link.badge_class
              ]}>
                {link.badge}
              </span>
            </div>

            <div class="relative mt-8">
              <h3 class="text-xl font-semibold text-white">{link.title}</h3>
              <p class="mt-2 max-w-sm text-sm leading-6 text-slate-300">
                {link.description}
              </p>
            </div>

            <p class="relative mt-6 text-xs uppercase tracking-[0.22em] text-slate-400">
              {link.path_label}
            </p>
          </a>
        </div>
      </section>

      <section class="mt-14">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 class="text-sm uppercase tracking-[0.24em] text-emerald-200/70">
              Utilities
            </h2>
            <p class="mt-2 text-sm text-slate-400">
              Supporting pages for deeper inspection and maintenance.
            </p>
          </div>
        </div>

        <div
          id="froth-secondary-links"
          class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-3"
        >
          <a
            :for={link <- @secondary_links}
            id={link.id}
            href={link.href}
            class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-4 transition duration-200 hover:border-white/20 hover:bg-white/10"
          >
            <span class={[
              "inline-flex size-10 shrink-0 items-center justify-center rounded-2xl border",
              link.icon_class
            ]}>
              <.icon name={link.icon} class="size-4" />
            </span>

            <div class="min-w-0 flex-1">
              <h3 class="text-sm font-semibold text-white">{link.title}</h3>
              <p class="mt-1 text-sm leading-6 text-slate-400">
                {link.description}
              </p>
            </div>

            <.icon
              name="hero-arrow-right"
              class="size-4 shrink-0 text-white/35 transition group-hover:translate-x-0.5 group-hover:text-white/70"
            />
          </a>
        </div>
      </section>
    </div>
  </main>
</Layouts.app>
