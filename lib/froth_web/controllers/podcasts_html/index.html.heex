<Layouts.app flash={@flash} variant={:plain}>
  <div class="min-h-screen bg-[#0a0c10] text-[#c8ccd4] font-mono">
    <div class="mx-auto max-w-[1400px] px-4 py-6 md:px-8">
      <%!-- HEADER --%>
      <header class="mb-8 border-b-2 border-[#2a2d35] pb-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-[10px] uppercase tracking-[0.3em] text-[#5a6070]">
              Froth / Voice Archive
            </p>
            <h1 class="mt-2 text-4xl font-bold uppercase tracking-tight text-[#e8e4d8] sm:text-5xl">
              Podcasts
            </h1>
            <p class="mt-2 text-sm text-[#6a7080]">
              Every generated episode. Audio elements and manuscripts.
            </p>
          </div>
          <div class="flex gap-6 text-center">
            <div class="border border-[#2a2d35] bg-[#12141a] px-4 py-3">
              <p class="text-2xl font-bold text-[#e8e4d8]">{@total}</p>
              <p class="text-[10px] uppercase tracking-[0.2em] text-[#5a6070]">Episodes</p>
            </div>
            <div class="border border-[#2a2d35] bg-[#12141a] px-4 py-3">
              <p class="text-2xl font-bold text-[#e8e4d8]">{@total_segments}</p>
              <p class="text-[10px] uppercase tracking-[0.2em] text-[#5a6070]">Segments</p>
            </div>
          </div>
        </div>
        <div class="mt-4">
          <a
            href={~p"/froth"}
            class="text-xs uppercase tracking-[0.2em] text-[#5a6070] hover:text-[#c8ccd4] transition"
          >
            &larr; Froth
          </a>
        </div>
      </header>

      <%!-- EPISODES --%>
      <div class="space-y-4">
        <div
          :for={{script, idx} <- Enum.with_index(@scripts)}
          class={"border-2 " <> FrothWeb.PodcastsHTML.card_bg(idx)}
        >
          <div class="p-4 md:p-5">
            <%!-- Title row --%>
            <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
              <div class="flex-1 min-w-0">
                <h2 class="text-lg font-bold uppercase tracking-wide text-[#e8e4d8] truncate">
                  {script.label || "Episode ##{script.id}"}
                </h2>
                <p class="mt-1 text-[11px] uppercase tracking-[0.2em] text-[#5a6070]">
                  {FrothWeb.PodcastsHTML.format_date(script.inserted_at)}
                  <span :if={FrothWeb.PodcastsHTML.speakers(script.script) != ""} class="ml-2">
                    · {FrothWeb.PodcastsHTML.speakers(script.script)}
                  </span>
                  · {length(script.script || [])} segments
                  · {script.status}
                </p>
              </div>
              <div :if={script.batch_id} class="shrink-0">
                <code class="text-[10px] text-[#4a5060]">{script.batch_id}</code>
              </div>
            </div>

            <%!-- Audio player --%>
            <div :if={script.audio_url} class="mt-3">
              <audio
                controls
                preload="none"
                class="w-full h-10 [&::-webkit-media-controls-panel]:bg-[#12141a]"
              >
                <source src={script.audio_url} type="audio/mpeg" />
              </audio>
            </div>
            <div :if={is_nil(script.audio_url)} class="mt-3">
              <p class="text-xs italic text-[#3a4050]">No audio — {script.status}</p>
            </div>

            <%!-- Manuscript --%>
            <details :if={script.script && script.script != []} class="mt-3 group">
              <summary class="cursor-pointer text-[11px] uppercase tracking-[0.2em] text-[#5a6070] hover:text-[#c8ccd4] transition select-none">
                Manuscript ({length(script.script)} lines)
              </summary>
              <div class="mt-3 max-h-[60vh] overflow-y-auto border-t border-[#2a2d35] pt-3 space-y-2">
                <div
                  :for={{speaker, text} <- FrothWeb.PodcastsHTML.manuscript_lines(script.script)}
                  class="flex gap-3 text-sm leading-relaxed"
                >
                  <span class="shrink-0 font-bold uppercase text-[11px] tracking-wide text-[#7a8090] w-24 text-right pt-0.5">
                    {speaker}
                  </span>
                  <span class="flex-1 text-[#b0b8c4]">
                    {text}
                  </span>
                </div>
              </div>
            </details>
          </div>
        </div>
      </div>

      <%!-- FOOTER --%>
      <footer class="mt-12 border-t border-[#2a2d35] pt-6 pb-8 text-center">
        <p class="text-[10px] uppercase tracking-[0.3em] text-[#3a4050]">
          The chat narrates itself. The narration is archived here.
        </p>
      </footer>
    </div>
  </div>
</Layouts.app>
