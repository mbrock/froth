#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -s)" in
  Darwin)
    exec "$SCRIPT_DIR/launch_agent" logs "$@"
    ;;
  Linux)
    exec journalctl --user -u froth -o cat --no-hostname "$@"
    ;;
  *)
    echo "Unsupported OS for bin/logs" >&2
    exit 1
    ;;
esac
