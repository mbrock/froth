#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "bin/launch_agent is only for macOS launchd" >&2
  exit 1
fi

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_ROOT="${FROTH_APP_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"
LABEL="${FROTH_LAUNCHD_LABEL:-sh.froth}"
DOMAIN="gui/$(id -u)"
TARGET="$DOMAIN/$LABEL"
PLIST_DIR="$HOME/Library/LaunchAgents"
PLIST_PATH="$PLIST_DIR/$LABEL.plist"
LOG_DIR="$HOME/Library/Logs/froth"
STDOUT_LOG="$LOG_DIR/stdout.log"
STDERR_LOG="$LOG_DIR/stderr.log"

# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/runtime_env.sh"
load_froth_env "$APP_ROOT"

READY_TIMEOUT="${FROTH_LAUNCHD_READY_TIMEOUT:-60}"
HTTP_HOST="${FROTH_HTTP_IP:-127.0.0.1}"
HTTP_PORT="${PORT:-4000}"
HTTP_PATH="${FROTH_LAUNCHD_READY_PATH:-/froth/}"

usage() {
  cat <<EOF
Usage: bin/launch_agent <command>

Commands:
  install    write the LaunchAgent plist and load it
  uninstall  unload the LaunchAgent and remove its plist
  start      load or start the LaunchAgent
  stop       unload the LaunchAgent
  restart    kick the LaunchAgent
  wait       wait until the service is actually reachable
  status     print launchd status for the service
  logs       tail the service logs
  plist-path print the installed plist path
EOF
}

ensure_dirs() {
  mkdir -p "$PLIST_DIR" "$LOG_DIR"
  touch "$STDOUT_LOG" "$STDERR_LOG"
}

write_plist() {
  ensure_dirs

  cat >"$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$APP_ROOT/bin/dev_full</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$APP_ROOT</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>$STDOUT_LOG</string>
  <key>StandardErrorPath</key>
  <string>$STDERR_LOG</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FROTH_APP_ROOT</key>
    <string>$APP_ROOT</string>
    <key>HOME</key>
    <string>$HOME</string>
    <key>PHX_SERVER</key>
    <string>true</string>
  </dict>
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
</dict>
</plist>
EOF
}

is_loaded() {
  launchctl print "$TARGET" >/dev/null 2>&1
}

bootout_if_loaded() {
  if is_loaded; then
    launchctl bootout "$TARGET"
  else
    launchctl bootout "$DOMAIN" "$PLIST_PATH" >/dev/null 2>&1 || true
  fi
}

bootstrap() {
  launchctl bootstrap "$DOMAIN" "$PLIST_PATH"
}

service_ready() {
  local launchctl_status
  local rpc_ready_status

  launchctl_status="$(launchctl print "$TARGET" 2>/dev/null || true)"
  rpc_ready_status="$(
    "$APP_ROOT/bin/rpc" \
      'case {Process.whereis(Froth.Supervisor), Process.whereis(FrothWeb.Endpoint)} do
         {nil, _} -> :not_ready
         {_, nil} -> :not_ready
         _ -> :ready
       end' \
      2>/dev/null || true
  )"
  rpc_ready_status="$(printf '%s' "$rpc_ready_status" | tr -d '[:space:]')"

  [[ "$launchctl_status" == *"state = running"* ]] || return 1
  [[ "$rpc_ready_status" == ":ready" ]] || return 1
  return 0
}

wait_for_ready() {
  local timeout="$READY_TIMEOUT"
  local deadline=$((SECONDS + timeout))

  while (( SECONDS < deadline )); do
    if service_ready; then
      echo "Ready: $LABEL"
      echo "RPC node: $("$APP_ROOT/bin/rpc" "Node.self()" 2>/dev/null)"
      echo "HTTP: http://$HTTP_HOST:$HTTP_PORT$HTTP_PATH"
      return 0
    fi

    sleep 1
  done

  echo "Timed out waiting for $LABEL to become ready" >&2
  launchctl print "$TARGET" 2>/dev/null | sed -n '1,80p' >&2 || true
  echo "--- recent logs ---" >&2
  tail -n 40 "$STDOUT_LOG" "$STDERR_LOG" >&2 || true
  return 1
}

start_service() {
  if ! [ -f "$PLIST_PATH" ]; then
    echo "LaunchAgent plist is not installed: $PLIST_PATH" >&2
    exit 1
  fi

  if is_loaded; then
    launchctl kickstart -k "$TARGET"
  else
    bootstrap
  fi

  wait_for_ready
}

logs_service() {
  ensure_dirs

  if [[ $# -eq 0 ]]; then
    exec tail -f "$STDOUT_LOG" "$STDERR_LOG"
  fi

  if [[ "$1" == "-n" && $# -ge 2 ]]; then
    local lines="$2"
    shift 2
    exec tail -n "$lines" -f "$STDOUT_LOG" "$STDERR_LOG"
  fi

  exec tail "$@" "$STDOUT_LOG" "$STDERR_LOG"
}

command="${1:-}"
shift || true

case "$command" in
  install)
    write_plist
    bootout_if_loaded
    bootstrap
    wait_for_ready
    echo "Installed $LABEL"
    echo "Plist: $PLIST_PATH"
    ;;
  uninstall)
    bootout_if_loaded
    rm -f "$PLIST_PATH"
    echo "Removed $PLIST_PATH"
    ;;
  start)
    start_service
    ;;
  stop)
    bootout_if_loaded
    ;;
  restart)
    start_service
    ;;
  wait)
    wait_for_ready
    ;;
  status)
    exec launchctl print "$TARGET"
    ;;
  logs)
    logs_service "$@"
    ;;
  plist-path)
    printf '%s\n' "$PLIST_PATH"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
