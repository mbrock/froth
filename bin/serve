#!/usr/bin/env bash
# Wrapper for systemd: sources asdf and runs mix phx.server with --sname.
set -euo pipefail

export HOME="${HOME:-$(eval echo ~$(whoami))}"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.asdf/shims:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
. "$HOME/.asdf/asdf.sh"

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_ROOT="${FROTH_APP_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"

cd "$APP_ROOT"
epmd -daemon
exec elixir --erl "-kernel connect_all false prevent_overlapping_partitions false" --sname froth -S mix phx.server
