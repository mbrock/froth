#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_ROOT="${FROTH_APP_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"

# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/runtime_env.sh"
load_froth_env "$APP_ROOT"

cd "$APP_ROOT"

# Disable the BEAM break menu so Ctrl-C exits immediately.
export ERL_AFLAGS="${ERL_AFLAGS:+$ERL_AFLAGS }+Bd"

exec mix run --no-start -e 'Froth.Mix.Follow.main(System.argv())' -- "$@"
