# LLM provider config (API keys are stored in the api_keys database table)
export ANTHROPIC_MODEL="claude-opus-4-6"
export ANTHROPIC_MAX_TOKENS="16384"
export ANTHROPIC_SYSTEM=""

export OPENAI_MODEL="gpt-5-mini"
export OPENAI_MAX_TOKENS="16384"
export OPENAI_SYSTEM=""

export GROK_MODEL="grok-4-1-fast-non-reasoning"
export GROK_MAX_TOKENS="16384"
export GROK_SYSTEM=""

export GEMINI_MODEL="gemini-3-flash-preview"
export GEMINI_MAX_TOKENS="16384"
export GEMINI_SYSTEM=""

# Telegram
export TELEGRAM_BOT_TOKEN="..."
export TDLIB_API_ID="..."
export TDLIB_API_HASH="..."
export PHX_SERVER="true"

# Analyzer: which TDLib session to use for file downloads
export ANALYZER_TDLIB_SESSION="mbrockman"

# Podcast hosting
export PODCAST_DOCROOT="/path/to/podcast/files"
export PODCAST_PUBLIC_BASE="https://example.com"

# Cluster
export FROTH_NODE_ROLE="full"
export FROTH_NODE_NAME="froth@temple.local"
export FROTH_COORDINATOR_NODE="froth@igloo"
export FROTH_CLUSTER_NODES="froth@igloo,froth@swa,froth@Mikaels-Mac-mini"
export FROTH_HTTP_IP="100.64.48.44"

# On Macs where the short hostname resolves to a Tailscale IP, add a loopback
# alias in /etc/hosts (for example: temple.local) and point Froth at it with
# FROTH_NODE_NAME above.

# Standalone dev full node on a fresh machine:
# export FROTH_CLUSTER_NODES="off"
# export FROTH_DISABLE_CHARLIE="1"
# export FROTH_DAILY_DIGEST_ENABLED="0"

# Shared object store for clustered render artifacts
export FROTH_OBJECT_STORE_MODE="local"
export FROTH_OBJECT_STORE_ROOT_DIR="/path/to/object-store"
export FROTH_OBJECT_STORE_PUBLIC_BASE="http://igloo:4000/froth/objects"
export FROTH_OBJECT_STORE_INTERNAL_BASE="http://igloo:4000/froth/objects"
export FROTH_OBJECT_STORE_TOKEN="change-me"

# Public browser origin for large Telegram video links. This may differ from
# the object store's internal cluster origin.
export FROTH_VIDEO_HOST_PUBLIC_BASE="https://example.com/froth/objects"
export FROTH_VIDEO_HOST_THRESHOLD_BYTES="104857600"

# Browser runtime
export FROTH_BROWSER_PROFILE="headless_bulk"
export FROTH_BROWSER_EXECUTABLE="/usr/bin/chromium"
export FROTH_VIDEO_COMPUTE_WORKER_COUNT="2"

# Bot user IDs (Telegram)
export CHARLIE_BOT_USER_ID="..."
export CHARLIE_OWNER_USER_ID="..."
export BERTIL_BOT_USER_ID="..."
export BERTIL_OWNER_USER_ID="..."
